{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": ["Tmds2.DBus/Tmds2.DBus.csproj"]
        }
      ],
      "dest": "api/Tmds2.DBus",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "EnumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    },
    {
      "src": [
        {
          "src": "..",
          "files": ["Tmds2.DBus.Protocol/Tmds2.DBus.Protocol.csproj"]
        }
      ],
      "dest": "api/Tmds2.DBus.Protocol",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "EnumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**/**.yml", "api/**/index.md"]
      },
      {
        "files": ["*.md", "toc.yml"],
        "exclude": ["README.md"]
      }
    ],
    "overwrite": [
      {
        "files": ["namespaces/**.md"]
      }
    ],
    "resource": [
      {
        "src": "../icon",
        "files": ["icon.svg", "icon_128.png"]
      }
    ],
    "output": "../../_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Tmds2.DBus Documentation",
      "_appName": "Tmds2.DBus",
      "_appLogoPath": "icon.svg",
      "_appFaviconPath": "icon.svg",
      "_enableSearch": true
    }
  }
}
